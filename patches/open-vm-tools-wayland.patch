+
+void
+DnDUIWayland::OnPointerEnter(struct wl_surface *surface)   // IN
+{
+   if (surface == mSurface) {
+      mPointerInDetWnd = true;
+   }
+}
+
+
+void
+DnDUIWayland::OnPointerLeave(struct wl_surface *surface)   // IN
+{
+   if (surface == mSurface) {
+      mPointerInDetWnd = false;
+   }
