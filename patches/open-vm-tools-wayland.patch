diff --git a/services/plugins/dndcp/copyPasteUIWayland.cpp b/services/plugins/dndcp/copyPasteUIWayland.cpp
new file mode 100644
index 00000000..9d8859eb
--- /dev/null
+++ b/services/plugins/dndcp/copyPasteUIWayland.cpp
@@ -0,0 +1,1579 @@
